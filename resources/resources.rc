#include "resource.h"
#include <windows.h>

// Application icon (placed in resources/ folder)
// Uncomment if you have an icon file:
// IDI_APP_ICON  ICON  "app.ico"
// IDI_TRAY_ICON ICON  "tray.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     3,0,0,0
PRODUCTVERSION  3,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Traffic Monitor"
            VALUE "FileDescription",  "Wi-Fi Traffic Monitor v3.0"
            VALUE "FileVersion",      "3.0.0.0"
            VALUE "InternalName",     "TrafficMonitor"
            VALUE "LegalCopyright",   "2024"
            VALUE "OriginalFilename", "TrafficMonitor.exe"
            VALUE "ProductName",      "Traffic Monitor"
            VALUE "ProductVersion",   "3.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
